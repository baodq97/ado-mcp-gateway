# Entra app registration (the ONE static app behind simulated DCR)
ADO_GW_CLIENT_ID=00000000-0000-0000-0000-000000000000
ADO_GW_CLIENT_SECRET=changeme

# Azure DevOps organization (positional arg of @azure-devops/mcp — required)
ADO_GW_ORG=myorg

# Directory to authenticate against. "organizations" = account's HOME tenant.
# Set a tenant GUID when the ADO org lives in a directory where users are guests:
#   curl -sI https://dev.azure.com/{org}/_apis/connectionData | grep -i x-vss-resourcetenant
ADO_GW_TENANT=organizations

# Public base URL of this gateway (must match the app's redirect URI host)
ADO_GW_BASE_URL=http://localhost:8090
ADO_GW_HOST=127.0.0.1
ADO_GW_PORT=8090
